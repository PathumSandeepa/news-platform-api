# Database connection URL
DATABASE_URL=

# Port the backend server will run on
PORT=

# URL of the connected frontend application
FRONTEND_URL=

# Secret key used for signing JSON Web Tokens
JWT_SECRET=

# Duration before a JWT expires
JWT_EXPIRES_IN=

# hCaptcha secret key for server-side verification
HCAPTCHA_SECRET=

# hCaptcha site key for frontend widget
HCAPTCHA_SITE_KEY=

# Set to true to skip CAPTCHA verification in local development
HCAPTCHA_SKIP_VERIFY=false